   "execution_count": null,
   "id": "4b7f42a0-16c8-4641-8a2d-377815287035",
   "metadata": {},
   "outputs": [],
   "source": [
    "%store a"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "36dd9778-e7ad-469d-9020-828aaf1c4b76",
   "metadata": {},
   "outputs": [],
   "source": [
    "# restart the kernel and 'a' is still stored"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f5fa11e9-c691-46bb-8ec5-cf6f990df8c0",
   "metadata": {},
   "outputs": [],
